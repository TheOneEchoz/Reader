{
  "name": "Tankōbon Reader",
  "short_name": "Tankōbon",
  "description": "Read folders of images like manga: chapters, page layouts, zoom and saved progress.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#0F1013",
